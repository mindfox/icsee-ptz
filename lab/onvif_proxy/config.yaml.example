server:
  listen_host: 0.0.0.0

defaults:
  upstream_timeout: 10
  retry_initial_seconds: 0.25
  retry_max_seconds: 2.0

cameras:
  cam_2:
    listen_port: 8999

    upstream:
      host: 192.168.31.176
      onvif_port: 8899
      username: admin
      password: ${FRIGATE_CAM2_ONVIF_PASSWORD}

    ptz:
      profile_token: "000"

      relative_move:
        velocity: 0.5
        pulse_min_seconds: 0.04
        pulse_seconds_per_fov: 0.8
        pulse_max_seconds: 1.0
        status_settle_seconds: 0.2

      zoom:
        relative_velocity: 0.5
        absolute_full_travel_seconds: 8.0

      return_preset_zoom_reset:
        enabled: true
        delay_seconds: 0.25
        velocity: -0.5
        duration_seconds: 8.0

      preset_aliases:
        "0": vertical
